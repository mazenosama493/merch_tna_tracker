 "queries": {
  "workbook-5-tna_critical_path_timeline": {
   "folder": "Untitled",
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "workbook-5-tna_critical_path_timeline",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT \n    t.buyer,\n    t.factory,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    COALESCE(e.sequence, 99) AS seq,\n    CONCAT(LPAD(COALESCE(e.sequence, 99), 2, '0'), ' - ', d.event_name) AS milestone_ordered,\n    d.event_name AS milestone,\n    d.plan_date AS planned_date,\n    d.actual_date AS actual_date,\n    d.days_offset AS planned_day_offset,\n    (d.days_offset + DATEDIFF(d.actual_date, d.plan_date)) AS actual_day_offset,\n    -- 1. Positive number for delays (e.g., +21 days late)\n    DATEDIFF(d.actual_date, d.plan_date) AS delay_days,\n    -- 2. Negative number for delays (e.g., -21 days variance, matching your cards)\n    DATEDIFF(d.plan_date, d.actual_date) AS variance_days,\n    CASE \n        WHEN DATEDIFF(d.actual_date, d.plan_date) > 14 THEN 'Severe Delay (>14d)'\n        WHEN DATEDIFF(d.actual_date, d.plan_date) BETWEEN 7 AND 14 THEN 'Moderate Delay (7\u201314d)'\n        WHEN DATEDIFF(d.actual_date, d.plan_date) BETWEEN 1 AND 6 THEN 'Minor Delay (1\u20136d)'\n        ELSE 'On Time (<=0d)'\n    END AS delay_severity\nFROM `tabOrder TNA Tracker` t\nJOIN `tabTNA Tracker Detail` d ON d.parent = t.name\nLEFT JOIN `tabTNA Event` e ON e.name = d.event_name\nWHERE t.order_status != 'Completed'\n  AND d.actual_date IS NOT NULL",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "TNA_Critical_Path_Timeline",
   "use_live_connection": 1,
   "workbook": "workbook-5"
  },
  "workbook-5-tna_kpi_active_orders_and_failure": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "workbook-5-tna_kpi_active_orders_and_failure",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT \n    t.name AS tracker_id,\n    t.factory,\n    t.buyer,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    t.order_status,\n    t.so_qty,\n    t.total_events,\n    t.failed_events,\n    ROUND((t.failed_events / NULLIF(t.total_events, 0)) * 100, 1) AS order_failure_rate_pct\nFROM `tabOrder TNA Tracker` t\nWHERE t.order_status != 'Completed'",
     "type": "sql"
    }
   ],
   "sort_order": 0,
   "title": "TNA_KPI_Active_Orders_And_Failure",
   "use_live_connection": 1,
   "workbook": "workbook-5"
  },
  "workbook-5-tna_kpi_critical_bottleneck": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "workbook-5-tna_kpi_critical_bottleneck",
   "operations": [
    {
     "data_source": "Site DB",
     "raw_sql": "SELECT \n    t.buyer,\n    t.factory,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    d.event_name AS bottleneck_event,\n    DATEDIFF(d.plan_date, d.actual_date) AS delay_days,\n    CONCAT(\n        d.event_name, ' (', t.buyer, ' - ', t.style_no, ') | Plan: ', \n        DATE_FORMAT(d.plan_date, '%d-%b'), ' -> Act: ', DATE_FORMAT(d.actual_date, '%d-%b')\n    ) AS bottleneck_details\nFROM `tabOrder TNA Tracker` t\nJOIN `tabTNA Tracker Detail` d ON d.parent = t.name\nWHERE t.order_status != 'Completed'\n  AND d.actual_date IS NOT NULL\n  AND d.actual_date > d.plan_date\nORDER BY DATEDIFF(d.plan_date, d.actual_date) ASC",
     "type": "sql"
    }
   ],
   "sort_order": 2,
   "title": "TNA_KPI_Critical_Bottleneck",
   "use_live_connection": 1,
   "workbook": "workbook-5"
  },
  "workbook-5-tna_kpi_ex_factory_slippage": {
   "folder": null,
   "is_builder_query": 0,
   "is_native_query": 1,
   "is_script_query": 0,
   "name": "workbook-5-tna_kpi_ex_factory_slippage",
   "operations": [
    {
     "data_source": "Site DB",
