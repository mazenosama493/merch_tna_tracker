  "folders": [],
  "queries": {
    "workbook-5-tna_kpi_active_orders_and_failure": {
      "name": "workbook-5-tna_kpi_active_orders_and_failure",
      "title": "TNA_KPI_Active_Orders_And_Failure",
      "workbook": "workbook-5",
      "folder": null,
      "sort_order": 0,
      "use_live_connection": 1,
      "is_script_query": 0,
      "is_builder_query": 0,
      "is_native_query": 1,
      "operations": [
        {
          "data_source": "Site DB",
          "raw_sql": "SELECT \n    t.name AS tracker_id,\n    t.factory,\n    t.buyer,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    t.order_status,\n    t.so_qty,\n    t.total_events,\n    t.failed_events,\n    ROUND((t.failed_events / NULLIF(t.total_events, 0)) * 100, 1) AS order_failure_rate_pct\nFROM `tabOrder TNA Tracker` t\nWHERE t.order_status != 'Completed'",
          "type": "sql"
        }
      ]
    },
    "workbook-5-tna_kpi_ex_factory_slippage": {
      "name": "workbook-5-tna_kpi_ex_factory_slippage",
      "title": "TNA_KPI_Ex_Factory_Slippage",
      "workbook": "workbook-5",
      "folder": null,
      "sort_order": 1,
      "use_live_connection": 1,
      "is_script_query": 0,
      "is_builder_query": 0,
      "is_native_query": 1,
      "operations": [
        {
          "data_source": "Site DB",
          "raw_sql": "SELECT \n    t.name AS tracker_id,\n    t.factory,\n    t.buyer,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    t.ex_fty_date AS planned_ex_fty,\n    d.plan_date AS hod_plan_date,\n    d.actual_date AS hod_actual_date,\n    COALESCE(\n        DATEDIFF(d.plan_date, d.actual_date),\n        0\n    ) AS ex_fty_slippage_days\nFROM `tabOrder TNA Tracker` t\nLEFT JOIN `tabTNA Tracker Detail` d ON d.parent = t.name AND d.event_name = 'HOD'",
          "type": "sql"
        }
      ]
    },
    "workbook-5-tna_kpi_critical_bottleneck": {
      "name": "workbook-5-tna_kpi_critical_bottleneck",
      "title": "TNA_KPI_Critical_Bottleneck",
      "workbook": "workbook-5",
      "folder": null,
      "sort_order": 2,
      "use_live_connection": 1,
      "is_script_query": 0,
      "is_builder_query": 0,
      "is_native_query": 1,
      "operations": [
        {
          "data_source": "Site DB",
          "raw_sql": "SELECT \n    t.buyer,\n    t.factory,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    d.event_name AS bottleneck_event,\n    DATEDIFF(d.plan_date, d.actual_date) AS delay_days,\n    CONCAT(\n        d.event_name, ' (', t.buyer, ' - ', t.style_no, ') | Plan: ', \n        DATE_FORMAT(d.plan_date, '%d-%b'), ' -> Act: ', DATE_FORMAT(d.actual_date, '%d-%b')\n    ) AS bottleneck_details\nFROM `tabOrder TNA Tracker` t\nJOIN `tabTNA Tracker Detail` d ON d.parent = t.name\nWHERE t.order_status != 'Completed'\n  AND d.actual_date IS NOT NULL\n  AND d.actual_date > d.plan_date\nORDER BY DATEDIFF(d.plan_date, d.actual_date) ASC",
          "type": "sql"
        }
      ]
    },
    "workbook-5-tna_stage_delay_bar_chart": {
      "name": "workbook-5-tna_stage_delay_bar_chart",
      "title": "TNA_Stage_Delay_Bar_Chart",
      "workbook": "workbook-5",
      "folder": null,
      "sort_order": 3,
      "use_live_connection": 1,
      "is_script_query": 0,
      "is_builder_query": 0,
      "is_native_query": 1,
      "operations": [
        {
          "data_source": "Site DB",
          "raw_sql": "SELECT\n    t.name AS tracker,\n    t.factory,\n    t.buyer,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    d.event_name,\n    DATEDIFF(d.actual_date, d.plan_date) AS total_delay,\n    DATEDIFF(d.actual_date, d.plan_date) AS `Total Delay`,\n    CASE WHEN DATEDIFF(d.actual_date, d.plan_date) BETWEEN 1 AND 6\n         THEN DATEDIFF(d.actual_date, d.plan_date) END AS `Minor Delay (1-6d)`,\n    CASE WHEN DATEDIFF(d.actual_date, d.plan_date) BETWEEN 7 AND 14\n         THEN DATEDIFF(d.actual_date, d.plan_date) END AS `Moderate Delay (7-14d)`,\n    CASE WHEN DATEDIFF(d.actual_date, d.plan_date) > 14\n         THEN DATEDIFF(d.actual_date, d.plan_date) END AS `Severe Delay (>14d)`\nFROM `tabOrder TNA Tracker` t\nJOIN `tabTNA Tracker Detail` d ON d.parent = t.name\nWHERE t.order_status != 'Completed'\n    AND d.actual_date IS NOT NULL\n    AND d.actual_date > d.plan_date",
          "type": "sql"
        }
      ]
    },
    "workbook-5-tna_milestone_health_donut": {
      "name": "workbook-5-tna_milestone_health_donut",
      "title": "TNA_Milestone_Health_Donut",
      "workbook": "workbook-5",
      "folder": null,
      "sort_order": 4,
      "use_live_connection": 1,
      "is_script_query": 0,
      "is_builder_query": 0,
      "is_native_query": 1,
      "operations": [
        {
          "data_source": "Site DB",
          "raw_sql": "SELECT \n    t.buyer,\n    t.factory,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    d.name AS detail_row_id,\n    d.event_name,\n    CASE \n        WHEN d.actual_date IS NULL THEN 'Marked N/A (Unlogged)'\n        WHEN DATEDIFF(d.actual_date, d.plan_date) > 14 THEN 'Severe Delay (>14d)'\n        WHEN DATEDIFF(d.actual_date, d.plan_date) BETWEEN 7 AND 14 THEN 'Moderate Delay (7–14d)'\n        WHEN DATEDIFF(d.actual_date, d.plan_date) BETWEEN 1 AND 6 THEN 'Minor Delay (1–6d)'\n        ELSE 'On Time / Early (<=0d)'\n    END AS health_category\nFROM `tabOrder TNA Tracker` t\nJOIN `tabTNA Tracker Detail` d ON d.parent = t.name\nWHERE t.order_status != 'Completed'",
          "type": "sql"
        }
      ]
    },
    "workbook-5-tna_critical_path_timeline": {
      "name": "workbook-5-tna_critical_path_timeline",
      "title": "TNA_Critical_Path_Timeline",
      "workbook": "workbook-5",
      "folder": null,
      "sort_order": 5,
      "use_live_connection": 1,
      "is_script_query": 0,
      "is_builder_query": 0,
      "is_native_query": 1,
      "operations": [
        {
          "data_source": "Site DB",
          "raw_sql": "SELECT \n    t.buyer,\n    t.factory,\n    t.manager,\n    t.merchant,\n    t.style_no,\n    t.sales_order,\n    COALESCE(e.sequence, 99) AS seq,\n    CONCAT(LPAD(COALESCE(e.sequence, 99), 2, '0'), ' - ', d.event_name) AS milestone_ordered,\n    d.event_name AS milestone,\n    d.plan_date AS planned_date,\n    d.actual_date AS actual_date,\n    d.days_offset AS planned_day_offset,\n    (d.days_offset + DATEDIFF(d.actual_date, d.plan_date)) AS actual_day_offset,\n    -- 1. Positive number for delays (e.g., +21 days late)\n    DATEDIFF(d.actual_date, d.plan_date) AS delay_days,\n    -- 2. Negative number for delays (e.g., -21 days variance, matching your cards)\n    DATEDIFF(d.plan_date, d.actual_date) AS variance_days,\n    CASE \n        WHEN DATEDIFF(d.actual_date, d.plan_date) > 14 THEN 'Severe Delay (>14d)'\n        WHEN DATEDIFF(d.actual_date, d.plan_date) BETWEEN 7 AND 14 THEN 'Moderate Delay (7–14d)'\n        WHEN DATEDIFF(d.actual_date, d.plan_date) BETWEEN 1 AND 6 THEN 'Minor Delay (1–6d)'\n        ELSE 'On Time (<=0d)'\n    END AS delay_severity\nFROM `tabOrder TNA Tracker` t\nJOIN `tabTNA Tracker Detail` d ON d.parent = t.name\nLEFT JOIN `tabTNA Event` e ON e.name = d.event_name\nWHERE t.order_status != 'Completed'\n  AND d.actual_date IS NOT NULL",
          "type": "sql"
        }
      ]
    }
  },
